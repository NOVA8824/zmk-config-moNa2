#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100
#define MOUSE 5
#define SCROLL 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <0 1>;
        };

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <0 10>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <8 9>;
        };

        middlemkp {
            bindings = <&mkp MCLK>;
            key-positions = <30 31>;
        };

        ch_langage {
            bindings = <&kp LS(CAPS)>;
            key-positions = <39 38>;
        };
    };

    macros {
        nova: to_layer_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(T) &kp N1 &kp N0 &kp H &kp N7 &kp I &kp N3 &kp N2>;
            label = "TO_LAYER_0";
        };

        ad_work: ad_work {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N &kp O &kp B &kp A &kp T &kp A &kp MINUS &kp S &kp AT &kp A &kp Z &kp U &kp S &kp A &kp S &kp E &kp K &kp K &kp E &kp I &kp DOT &kp C &kp O &kp DOT &kp J &kp P>;
            label = "AD_WORK";
        };

        ad_home: ad_home {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp N &kp O &kp V &kp A &kp N8 &kp DOT &kp L &kp O &kp V &kp E &kp DOT &kp B &kp B &kp AT &kp G &kp M &kp A &kp I &kp L &kp DOT &kp C &kp O &kp M>;
            label = "AD_HOME";
        };

        localadmin: localadmin {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp DOT &kp BSLH &kp L &kp O &kp C &kp A &kp L &kp A &kp D &kp M &kp I &kp N>;
            label = "LOCALADMIN";
        };

        p_local: p_local {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(N) &kp LS(G) &kp LS(J) &kp LS(T) &kp LS(Z) &kp LS(I) &kp LS(Z) &kp LS(Q)>;
            label = "P_LOCAL";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&nova>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W         &kp E         &kp R             &kp T                                                 &kp Y        &kp U  &kp I      &kp O      &kp P
&kp A             &kp S         &kp D         &kp F             &kp G                                &kp MINUS        &kp H        &kp J  &kp K      &kp L      &kp SQT
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V             &kp B        &lt 4 SLASH             &lt 6 SEMICOLON  &kp N        &kp M  &mkp LCLK  &mkp RCLK  &mkp MCLK
&kp LCTRL         &kp LEFT_WIN  &kp LEFT_ALT  &lt 3 INT_HENKAN  &lt 2 SPACE  &mt LEFT_SHIFT SPACE    &kp BACKSPACE    &lt 1 ENTER                               &kp DEL
            >;

            sensor-bindings =
                <&scroll_up_down>,
                <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        layer_1 {
            bindings = <
&kp SLASH        &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp MINUS                        &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp AMPERSAND         &kp PERCENT   &kp AT_SIGN
&kp ASTERISK     &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp PLUS              &kp CARET  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp NON_US_BACKSLASH  &kp DOLLAR    &kp HASH
&kp KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD  &trans    &kp GRAVE  &kp LESS_THAN         &kp GREATER_THAN       &kp EXCLAMATION       &kp QUESTION  &kp TILDE
&trans           &trans           &trans           &trans           &trans      &trans    &trans     &trans                                                                           &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_2 {
            bindings = <
&kp TAB  &kp F7  &kp F8  &kp F9  &trans                                 &trans    &kp PAGE_UP     &kp UP_ARROW    &kp PAGE_DOWN    &trans
&trans   &kp F4  &kp F5  &kp F6  &trans            &kp INTERNATIONAL_2  &kp HOME  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp END
&trans   &kp F1  &kp F2  &kp F3  &trans  &trans    &kp INTERNATIONAL_5  &trans    &trans          &kp COMMA       &kp PERIOD       &trans
&trans   &trans  &trans  &trans  &trans  &trans    &kp BACKSPACE        &kp DEL                                                    &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_3 {
            bindings = <
&trans  &trans  &kp LC(X)  &kp LG(V)  &kp PRINTSCREEN                    &kp LG(I)  &trans  &trans  &trans  &trans
&trans  &trans  &kp LC(C)  &kp LC(V)  &trans                     &trans  &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans     &trans     &trans           &trans    &trans  &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans     &trans     &trans           &trans    &trans  &trans                             &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &kp KP_NUMLOCK  &kp CAPSLOCK                         &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans          &trans                  &trans       &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans          &trans        &trans    &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans          &trans        &trans    &trans       &trans                                                  &bt BT_CLR_ALL
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                                &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &nova        &ad_home  &ad_work  &trans  &trans
&trans  &trans  &trans  &trans  &trans            &trans  &localadmin  &p_local  &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans       &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                                   &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };
    };
};
